# Sitio
NEXT_PUBLIC_SITE_URL=https://www.ethosconsultoriadigital.com

# WhatsApp Business (formato 52XXXXXXXXXX). Si no existe, el botón flotante no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Bandeja que recibe las solicitudes de contacto
CONTACT_TO_EMAIL=ethosconsultoriadigital@gmail.com

# Remitente verificado en Resend (ej. contacto@tudominio.com)
# En pruebas: ETHOS Contacto <onboarding@resend.dev> (solo envía al email de la cuenta Resend)
CONTACT_FROM_EMAIL=ETHOS Contacto <onboarding@resend.dev>

# Neon Postgres — respaldo de leads (opcional; el correo funciona sin esto)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
