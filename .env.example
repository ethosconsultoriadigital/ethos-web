# Sitio
NEXT_PUBLIC_SITE_URL=https://www.ethosconsultoriadigital.com

# WhatsApp Business (formato 52XXXXXXXXXX). Si no existe, el botón flotante no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Píxel de Meta. Si no existe, el píxel no se carga.
NEXT_PUBLIC_META_PIXEL_ID=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Bandeja que recibe las solicitudes de contacto.
# Si no está definida, el sitio usa contacto@ethosconsultoriadigital.com.
CONTACT_TO_EMAIL=contacto@ethosconsultoriadigital.com

# Remitente de las solicitudes. Requiere verificar el dominio en Resend.
# Sin dominio verificado, Resend solo permite: ETHOS Contacto <onboarding@resend.dev>
CONTACT_FROM_EMAIL=ETHOS Contacto <contacto@ethosconsultoriadigital.com>

# Neon Postgres — respaldo de leads (opcional; el correo funciona sin esto)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
